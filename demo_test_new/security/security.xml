<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 20 已移除 ir.rule 与 ir.model.access，统一合并为 ir.access：
         - 带 group_id 的是「权限」(permission)：该组只能对 domain 内的记录做 operation 里的操作；
           同一用户的多条权限取 OR。
         - 不带 group_id 的是「限制」(restriction)：对 domain 之外的记录禁止该操作。
         - operation 取 'crud' 的子集，如 r / cu / cru / crud。
         - domain 留空即表示全部记录（只有真正需要过滤时才写）。
           注意不能再写 [(1, '=', 1)]：新模型的 _check_domain 会用 Domain().validate()
           校验字段名，'(1, '=', 1)' 里的 1 不是合法字段，会直接抛 ValidationError。
         行级过滤与模型级权限现在由同一条记录表达，所以「读全部 + 只改草稿」要拆成两条。 -->

    <!-- ============ l.sale.order ============ -->
    <record id="l_sale_order_access_operator_read" model="ir.access">
        <field name="name">订单：操作员可读全部</field>
        <field name="model_id" ref="model_l_sale_order"/>
        <field name="group_id" ref="l_group_order_user"/>
        <field name="operation">r</field>
    </record>

    <record id="l_sale_order_access_operator_draft" model="ir.access">
        <field name="name">订单：操作员只能新建/修改草稿单</field>
        <field name="model_id" ref="model_l_sale_order"/>
        <field name="group_id" ref="l_group_order_user"/>
        <field name="operation">cu</field>
        <field name="domain">[('state', '=', 'draft')]</field>
    </record>

    <record id="l_sale_order_access_manager_all" model="ir.access">
        <field name="name">订单：管理员不受限制</field>
        <field name="model_id" ref="model_l_sale_order"/>
        <field name="group_id" ref="l_group_order_manager"/>
        <field name="operation">crud</field>
    </record>

    <!-- ============ l.sale.order.line ============ -->
    <record id="l_sale_order_line_access_operator_read" model="ir.access">
        <field name="name">明细行：操作员可读全部</field>
        <field name="model_id" ref="model_l_sale_order_line"/>
        <field name="group_id" ref="l_group_order_user"/>
        <field name="operation">r</field>
    </record>

    <record id="l_sale_order_line_access_operator_draft" model="ir.access">
        <field name="name">明细行：操作员只能改草稿单的明细</field>
        <field name="model_id" ref="model_l_sale_order_line"/>
        <field name="group_id" ref="l_group_order_user"/>
        <field name="operation">cu</field>
        <field name="domain">[('order_id.state', '=', 'draft')]</field>
    </record>

    <record id="l_sale_order_line_access_operator_unlink" model="ir.access">
        <field name="name">明细行：操作员可删除</field>
        <field name="model_id" ref="model_l_sale_order_line"/>
        <field name="group_id" ref="l_group_order_user"/>
        <field name="operation">d</field>
    </record>

    <record id="l_sale_order_line_access_manager_all" model="ir.access">
        <field name="name">明细行：管理员不受限制</field>
        <field name="model_id" ref="model_l_sale_order_line"/>
        <field name="group_id" ref="l_group_order_manager"/>
        <field name="operation">crud</field>
    </record>

    <!-- ============ l.task ============ -->
    <!-- 含 user.id 的 domain 不是字面量，_get_all_access 会退回 safe_eval 求值，仍然有效 -->
    <record id="l_task_access_operator_own" model="ir.access">
        <field name="name">任务：操作员只能操作自己的 + 未指派的</field>
        <field name="model_id" ref="model_l_task"/>
        <field name="group_id" ref="l_group_order_user"/>
        <field name="operation">cru</field>
        <field name="domain">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
    </record>

    <record id="l_task_access_manager_all" model="ir.access">
        <field name="name">任务：管理员不受限制</field>
        <field name="model_id" ref="model_l_task"/>
        <field name="group_id" ref="l_group_order_manager"/>
        <field name="operation">crud</field>
    </record>

</odoo>
