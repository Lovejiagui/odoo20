<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="l_sale_order_wizard_form_view" model="ir.ui.view">
        <field name="name">l.sale.order.wizard.form.view</field>
        <field name="model">l.sale.order.wizard</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="批量处理">
                <p class="text-muted">
                    已选中 <field name="order_count" class="d-inline fw-bold"/> 条单据，留空的字段不会被修改。
                </p>

                <group>
                    <group>
                        <field name="payment_type"/>
                        <field name="validate_date"/>
                    </group>
                    <group>
                        <field name="remark" placeholder="不修改"/>
                    </group>
                </group>

                <field name="order_ids" readonly="1">
                    <list>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="payment_type"/>
                        <field name="validate_date"/>
                        <field name="state"/>
                    </list>
                </field>

                <footer>
                    <button name="action_confirm" string="确认" type="object" class="btn-primary"/>
                    <button string="取消" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- 向导专用动作：target=new 表示以模态弹窗方式打开 -->
    <record id="l_sale_order_wizard_action" model="ir.actions.act_window">
        <field name="name">批量处理</field>
        <field name="res_model">l.sale.order.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="l_sale_order_wizard_form_view"/>
        <field name="target">new</field>
        <!-- 绑定到销售单模型，列表视图勾选记录后「操作」菜单里就会出现这一项 -->
        <field name="binding_model_id" ref="demo_test_new.model_l_sale_order"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
